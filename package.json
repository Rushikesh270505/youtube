{
  "name": "crypto-live-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app shell for the Crypto Live Analysis stream overlay.",
  "main": "electron/main.js",
  "author": "Rushikesh Katari",
  "scripts": {
    "prepare:resources": "python3 scripts/prepare_app_resources.py",
    "build:backend": "python3 -m PyInstaller backend_server.spec --noconfirm",
    "electron:dev": "electron .",
    "build:app": "npm run prepare:resources && npm run build:backend && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "dist:mac": "npm run prepare:resources && npm run build:backend && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cryptoliveanalysis.app",
    "productName": "Crypto Live Analysis",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist/crypto-live-analysis-backend",
        "to": "backend"
      },
      {
        "from": "app-resources",
        "to": "app-resources"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ]
    }
  }
}
